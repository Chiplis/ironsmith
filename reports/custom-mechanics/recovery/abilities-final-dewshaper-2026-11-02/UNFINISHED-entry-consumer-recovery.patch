+#[test]
+fn actual_dewshaper_changes_authored_and_intrinsic_effect_entry_counters_before_the_entry_snapshot(){
+ for watcher_definition in definitions(){
+  for mode in ["native-entry","entry-program","starting-loyalty"]{
+   let mut game=GameState::new(vec!["A".into(),"B".into()],20);
+   let watcher=game.create_object_from_definition(&watcher_definition,A,Zone::Battlefield);
+   let body=match mode{
+    "native-entry"=>"Type: Creature — Human\nPower/Toughness: 8/8\nThis creature enters with three +1/+1 counters.",
+    "entry-program"=>"Type: Creature — Human\nPower/Toughness: 8/8\nAs this creature enters, put three +1/+1 counters on it.",
+    _=>"Type: Planeswalker\nLoyalty: 3",
+   };
+   let entrant=ironsmith_compiler_runtime::compile_to_runtime_definition("Entry counter recipient",body,false).unwrap();
+   let source=game.create_object_from_definition(&entrant,A,Zone::Hand);let stable=game.object(source).unwrap().stable_id;
+   let mut dm=Allocations{counts:vec![1,1,0].into(),asked:vec![]};
+   let mut ctx=ExecutionContext::new(watcher,A,&mut dm);
+   let outcome=execute_effect(&mut game,&Effect::move_to_zone(ironsmith::target::ChooseSpec::SpecificObject(source),Zone::Battlefield,false),&mut ctx).unwrap();
+   drop(ctx);
+   let entered=game.find_object_by_stable_id(stable).unwrap();assert_eq!(game.object(entered).unwrap().zone,Zone::Battlefield);
+   if mode=="starting-loyalty"{
+    assert_eq!(game.counter_count(entered,CounterType::Loyalty),1);assert_eq!(game.counter_count(entered,CounterType::Flying),1);assert_eq!(game.counter_count(entered,CounterType::Vigilance),1);assert_eq!(dm.asked,vec![A;3]);
+   }else{
+    assert_eq!(game.counter_count(entered,CounterType::PlusOnePlusOne),1,"{mode}");assert_eq!(game.counter_count(entered,CounterType::Flying),1,"{mode}");assert_eq!(game.counter_count(entered,CounterType::Vigilance),1,"{mode}");
+    assert_eq!(dm.asked,vec![A;3],"{mode}");
+    let event=outcome.events.iter().find_map(|event|event.downcast::<ironsmith::events::EnterBattlefieldEvent>()).expect("entry notification");
+    let snapshot=event.completed_snapshot.as_ref().expect("entry-time snapshot");assert_eq!(snapshot.counter_count(CounterType::Flying),1);assert_eq!(snapshot.counter_count(CounterType::Vigilance),1);assert_eq!(snapshot.counter_count(CounterType::PlusOnePlusOne),1);
+   }
+  }
+ }
