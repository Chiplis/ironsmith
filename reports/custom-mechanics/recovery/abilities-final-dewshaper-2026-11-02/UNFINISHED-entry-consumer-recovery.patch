+  use crate::events::cause::CauseFilterRuntimeExt as _;
+  if let Some(placement)=downcast_event::<crate::events::PutCountersEvent>(event){
+   if placement.count==0{return false;}
+   // Missing effect producer facts are a possible match, not a false one;
+   // the fallible admission boundary reports incomplete after recipient scope.
+   let unknown=placement.cause.cause_type.is_effect_like()&&(placement.cause.source.is_none()||placement.cause.source_controller.is_none());
