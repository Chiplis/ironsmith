 impl EnterBattlefieldEvent {
+    /// Complete per-producer evidence is required before a consumer separates
+    /// equal-kind entry counters by cause. Net removals or untracked initial
+    /// counters cannot be classified from a partial journal.
+    pub(crate) fn validate_counter_producer_receipts(
+        &self,
+    ) -> Result<(), crate::effects::ExecutionError> {
+        let totals = |groups: Vec<(CounterType, u32)>| {
+            let mut totals = std::collections::HashMap::<CounterType, u64>::new();
+            for (kind, count) in groups {
+                if count == 0 { continue; }
+                let total = totals.entry(kind).or_default();
+                *total = total.checked_add(u64::from(count)).ok_or_else(|| {
+                    crate::effects::ExecutionError::IncompleteEvidence(
+                        "entry counter producer totals overflow".into(),
+                    )
+                })?;
+            }
+            Ok::<_, crate::effects::ExecutionError>(totals)
+        };
+        if self.counter_producer_receipts.iter().any(|receipt|receipt.count>0
+            &&receipt.cause.cause_type.is_effect_like()
+            &&(receipt.cause.source.is_none()||receipt.cause.source_controller.is_none())) {
+            return Err(crate::effects::ExecutionError::IncompleteEvidence("effect entry counters lack captured producer identity/control".into()));
+        }
+        let proposed = totals(self.enters_with_counters.clone())?;
+        let producers = totals(self.counter_producer_receipts.iter()
+            .map(|receipt| (receipt.kind, receipt.count)).collect())?;
+        if proposed != producers {
+            return Err(crate::effects::ExecutionError::IncompleteEvidence(
+                "entry counters lack exact matching producer receipts".into(),
+            ));
+        }
+        Ok(())
+    }
