+#[cfg(test)]
+mod staged_entry_counter_producer_tests {
+    use super::*;
+
+    #[test]
+    fn successful_entry_placements_keep_distinct_frozen_producers() {
+        let actor = crate::ids::PlayerId::from_index(0);
+        let mut game = GameState::new(vec!["A".into(), "B".into()], 20);
+        let card = crate::card::CardBuilder::new(crate::ids::CardId::new(), "Entering witness")
+            .card_types(vec![crate::types::CardType::Creature]).build();
+        let entering = game.create_object_from_card(&card, actor, crate::zone::Zone::Hand);
+        let kind = crate::object::CounterType::PlusOnePlusOne;
+        let mut ctx = ExecutionContext::new_default(entering, actor);
+        ctx.replacement.entry_counter_source = Some(entering);
+        for (amount, labels) in [(2, vec!["growth".to_string()]), (3, Vec::new())] {
+            let mut cause = crate::events::cause::EventCause::from_effect(entering, actor);
+            cause.resolving_ability_designations = labels;
+            let event = Event::put_counters(entering, kind, amount, cause);
+            let output = execute_object_counter_placement(&mut game, &mut ctx, event).unwrap();
+            assert_eq!(output.count_or_zero(), i64::from(amount));
+        }
+        assert_eq!(ctx.replacement.entry_counter_receipts.len(), 2);
+        let mut entry = crate::events::EnterBattlefieldEvent::new(entering, crate::zone::Zone::Hand)
+            .with_counters(kind, 5);
+        entry.counter_producer_receipts = ctx.replacement.entry_counter_receipts.clone();
+        entry.validate_counter_producer_receipts().unwrap();
+        let receipts = &entry.counter_producer_receipts;
+        assert_eq!((receipts[0].count, receipts[1].count), (2, 3));
+        assert_eq!(receipts[0].cause.resolving_ability_designations, vec!["growth"]);
+        assert!(receipts[1].cause.resolving_ability_designations.is_empty());
+        // Enrichment/reconciliation in a sibling proposal cannot mutate this
+        // original receipt or its explicit empty producer designation.
+        let mut sibling = entry.clone();
+        sibling.counter_producer_receipts[0].cause.resolving_ability_designations.clear();
+        assert_eq!(entry.counter_producer_receipts[0].cause.resolving_ability_designations, vec!["growth"]);
+        sibling.enters_with_counters[0].1 = 4;
+        assert!(matches!(sibling.validate_counter_producer_receipts(),
+            Err(ExecutionError::IncompleteEvidence(_))));
+        sibling.counter_producer_receipts.clear();
+        assert!(matches!(sibling.validate_counter_producer_receipts(),
+            Err(ExecutionError::IncompleteEvidence(_))));
+        ctx.replacement.entry_counter_source = None;
+        let cause = crate::events::cause::EventCause::from_effect(entering, actor);
+        execute_object_counter_placement(&mut game, &mut ctx,
+            Event::put_counters(entering, kind, 1, cause)).unwrap();
+        assert_eq!(ctx.replacement.entry_counter_receipts.len(), 2,
+            "ordinary placements do not contaminate staged entry provenance");
+    }
+}
