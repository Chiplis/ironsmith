{
  "name": "ironsmith-ui",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@11.1.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node ./scripts/build-scryfall-i18n.mjs --if-changed --locale es && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "i18n:extract-static": "node ./scripts/extract-i18n-static.mjs",
    "i18n:collect-generated": "node ./scripts/collect-generated-i18n.mjs",
    "i18n:build-scryfall": "node ./scripts/build-scryfall-i18n.mjs",
    "signal": "node ./scripts/peer-server.mjs",
    "test:peerjs": "bash scripts/run-peerjs-tests.sh",
    "test:p2p-browser": "node tests/p2p-browser-scenarios.mjs",
    "test:hidden-info": "node tests/hidden-info-inventory.mjs",
    "test:wasm-real-engine": "node --test tests/wasm-real-engine-cheat.e2e.test.js"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tailwindcss/vite": "^4.2.1",
    "animejs": "^4.3.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.576.0",
    "peerjs": "^1.5.5",
    "radix-ui": "^1.4.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^25.3.3",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "peer": "^1.0.2",
    "playwright": "^1.59.1",
    "shadcn": "^3.8.5",
    "tw-animate-css": "^1.4.0",
    "vite": "^7.3.1"
  }
